{
  "name": "dsh-vibe-reading",
  "version": "0.3.0",
  "description": "Vibe Reading: a DSH sidebar workspace for reading papers — the PDF renders with its original layout and fonts, and highlights, notes, keywords and code links are shared with the agent across sessions.",
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "public",
    "README.md"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "better-sidebar",
    "pdf",
    "paper",
    "reader"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-better-sidebar"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jypjypjypjyp/dsh-vibe-reading.git"
  },
  "homepage": "https://github.com/jypjypjypjyp/dsh-vibe-reading#readme",
  "bugs": {
    "url": "https://github.com/jypjypjypjyp/dsh-vibe-reading/issues"
  }
}
